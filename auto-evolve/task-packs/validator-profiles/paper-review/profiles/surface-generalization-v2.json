  "forbiddenPatterns": [
    {
      "id": "paper-review-task-id",
      "label": "paper-review task id",
      "pattern": "\\bpaper[-_ ]?review[-_ ]?133[3-8]\\b|(?<!\\d)133[3-8](?!\\d)",
      "flags": [
        "IGNORECASE"
      ],
      "severity": "block",
      "message": "Formal skill must not contain a concrete paper-review task id."
    },
    {
      "id": "answer-source-container",
      "label": "gold/private answer source",
      "pattern": "\\b(gold review|gold standard|gold rating|private answer|private oracle|ground[-_ ]?truth|official answer|hidden answer|reference answer|oracle answer)\\b",
      "flags": [
        "IGNORECASE"
      ],
      "severity": "block",
      "message": "Formal skill must not mention private/gold answer containers."
    },
    {
      "id": "private-answer-path",
      "label": "private answer path",
      "pattern": "\\bprivate-answers\\b|gold-review\\.(txt|md|docx)|rating\\.txt",
      "flags": [
        "IGNORECASE"
      ],
      "severity": "block",
      "message": "Formal skill must not point to private answer files."
    },
    {
      "id": "direct-rating-assignment",
      "label": "direct final rating assignment",
      "pattern": "\\b(this paper|the paper|it|the submission|submission)\\s+(should be|must be|is|gets|receives)\\s+(rated|scored|evaluated as)?\\s*(Strong\\s+Accept|Accept|Weak\\s+Accept|Borderline|Marginally\\s+Accept|Weak\\s+Reject|Reject|Strong\\s+Reject)\\b",
      "flags": [
        "IGNORECASE"
      ],
      "severity": "block",
      "message": "Formal skill may define the rating rubric, but must not assign a concrete rating to the current paper."
    },
    {
      "id": "paper-rating-heading-with-label",
      "label": "concrete Paper Rating heading",
      "pattern": "\\bPaper\\s+Rating\\s*[:=]\\s*(Strong\\s+Accept|Accept|Weak\\s+Accept|Borderline|Marginally\\s+Accept|Weak\\s+Reject|Reject|Strong\\s+Reject)\\b",
      "flags": [
        "IGNORECASE"
      ],
      "severity": "block",
      "message": "Formal skill may define the rating rubric, but must not include a concrete final Paper Rating value."
    }
  ],
  "contextualForbidden": [
    {
      "id": "rating-forcing-via-context",
      "label": "rating forcing via context",
      "triggerPattern": "\\b(Strong\\s+Accept|Accept|Weak\\s+Accept|Borderline|Marginally\\s+Accept|Weak\\s+Reject|Reject|Strong\\s+Reject)\\b",
      "contextPattern": "\\b(assign|give|predict|output|target\\s+rating|correct\\s+rating|expected\\s+rating|should\\s+be\\s+rated|must\\s+be\\s+rated)\\b",
      "flags": [
        "IGNORECASE"
      ],
      "windowWords": 10,
      "severity": "block",
      "message": "Concrete rating label appears in an answer-forcing context."
    },
    {
      "id": "specific-table-figure-critique",
      "label": "specific table/figure critique",
      "triggerPattern": "\\b(Table|Figure|Fig\\.|Eq\\.|Equation)\\s*\\d+[A-Za-z]?\\b",
      "contextPattern": "\\b(missing|outperforms|drops|anomalous|must\\s+cite|must\\s+mention|correct|gold|answer|rating|baseline)\\b",
      "flags": [
        "IGNORECASE"
      ],
      "windowWords": 10,
      "severity": "warn",
      "message": "Concrete table/figure references in reusable skill are risky; keep only generic table-checking procedures."
    }
  ]
}
