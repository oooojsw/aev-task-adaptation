      "blocking": true,
      "args": [
        "--answer",
        "../../private-answers/55708/answer.xlsx",
        "--candidate",
        "./workspace/answer.json",
        "--sheet",
        null,
        "--range",
        "B11:B13"
      ],
      "timeoutMs": 120000
    }
  ],
  "planning": {
    "agent": "top"
  },
  "execution": {
    "agent": "top"
  },
  "validation": {
    "agent": "top"
  },
