{
  "id": "spreadsheetbench-55708",
  "title": "spreadsheetbench-55708",
  "goal": "Solve one spreadsheet task from SpreadsheetBench.\nRead the input workbook and produce exactly one JSON file at workspace/answer.json.\nThe JSON schema must be:\n{\"answer_sheet\":\"<sheet>\",\"answer_position\":\"<range>\",\"values\":[[\"...\"]]}\nThe values matrix must match the expected answer cells exactly.",
  "taskFamily": "spreadsheetbench-learnbench",
  "domainTags": [
    "spreadsheet",
    "hard-validation",
    "answer-range"
  ],
  "materials": [
