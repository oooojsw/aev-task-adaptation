  "maintenanceOpsDir": "methods/maintenance-ops",
  "judgeSkillsDir": "judge-skills",
  "systemPromptsDir": "prompts",
  "methodsDir": "methods/recipes",
  "propagationDir": "runtime-state/propagation",
  "propagationMethodsDir": "methods/propagation",
  "optimizationDir": "runtime-state/optimization",
  "baselineFile": "baseline.md",
  "splitFile": "dataset/SPLIT.md",
  "scriptsDir": "scripts",
  "runsDir": "runtime-state/runs",
  "modelConfigFile": "model-config.json",
  "judgeConfigFile": "judge-config.json",
  "permissionConfigFile": "permission-config.json",
  "monitorConfigFile": "monitor-config.json",
  "concurrencyConfigFile": "concurrency-config.json",
  "directChatConfigFile": "direct-chat-models.example.json",
  "modelConfig": {
    "version": 1,
    "defaults": {
      "model": "alibaba-coding-plan-cn/qwen3.6-plus"
    },
    "limits": {
      "requestsPerMinute": 14
    },
    "phases": {
      "bootstrap": {},
      "solve": {},
      "refine": {},
      "verify": {},
      "regression": {}
    }
  },
  "judgeConfig": {
    "version": 1,
    "mode": "soft_plus_hard",
    "autoRunSkillIDs": ["exact-output", "tool-failures", "session-behavior"]
  },
  "permissionConfig": {
    "version": 1,
    "mode": "open"
  },
  "monitorConfig": {
    "version": 1,
    "enabled": true,
    "autoStart": true,
    "hostname": "127.0.0.1",
    "port": 4219,
    "intervalSeconds": 2,
    "defaultLimit": 50,
    "openBrowserOnStart": true
  },
  "concurrencyConfig": {
    "maxConcurrent": 15,
    "perScopeMaxConcurrent": 5,
    "maxQueueDepth": 60,
    "acquireTimeoutMs": 3600000,
    "minSpawnIntervalMs": 0
  },
  "stageConcurrency": {
    "training": 5,
    "merge": 1,
    "hierarchicalMerge": 2,
    "trainReplay": 3,
    "testBlank": 3,
    "testDirectChat": 4,
    "baseline": 3
  },
  "directChatConfig": {
    "defaultRunMode": "skill-full",
    "runModes": {
      "skill-full": {
        "description": "正式技能评测：完整注入最终 skill，题目和材料必须完整保留，不允许靠截断过关。",
        "skillMode": "with-skill",
        "skillInputMode": "full",
        "officeqaMaterialMode": "skillopt-oracle-json"
      },
      "skill-core": {
        "description": "紧凑技能评测：只注入核心文件版本 skill，题目和材料必须完整保留。",
        "skillMode": "with-skill",
        "skillInputMode": "core-files",
        "officeqaMaterialMode": "skillopt-oracle-json"
      },
      "skill-head-tail": {
        "description": "显式压缩技能评测：只允许压缩 skill 的中段，题目和材料必须完整保留。",
        "skillMode": "with-skill",
        "skillInputMode": "head-tail",
        "officeqaMaterialMode": "skillopt-oracle-json"
      },
      "no-skill-full-materials": {
        "description": "无技能基线：不注入任何训练得到的 skill，只给任务提示和完整材料。",
        "skillMode": "no-skill",
        "noSkillOnly": true,
        "officeqaMaterialMode": "skillopt-oracle-json"
      },
      "paired-skill-vs-noskill": {
        "description": "成对对照：同一批题同时跑完整 skill 和无 skill 基线。",
        "skillMode": "paired",
        "skillInputMode": "full",
        "includeNoSkillBaseline": true,
        "officeqaMaterialMode": "skillopt-oracle-json"
      },
      "native-pdf-skill-full": {
        "description": "原生材料链路：完整注入 skill，并使用数据集原始 PDF/材料路由能力。",
        "skillMode": "with-skill",
        "skillInputMode": "full",
        "officeqaMaterialMode": "native-pdf"
      }
    },
    "skillInput": {
      "mode": "full",
      "headRatio": 0.65
    },
    "defaultModelIDs": [
      "siliconflow-qwen3-6-35b-a3b"
